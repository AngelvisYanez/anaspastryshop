generator client {
  provider = "prisma-client-js"
}

// generator erd {
//   provider = "prisma-erd-generator"
//   output   = "./ERD.md"
// }

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String        @id @default(cuid())
  name               String?
  email              String        @unique
  password           String
  role               String        @default("USER")
  isApproved         Boolean       @default(false)
  isActive           Boolean       @default(true)
  deactivationReason String?
  image              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  activities         ActivityLog[]
  cursos             Curso[]         @relation("MentorCursos")
  inscripciones      Inscription[]
  subscription       Subscription?
  coursePurchases    CoursePurchase[]
  lives              LiveStream[]    @relation("InstructorLives")
  webinars           Webinar[]       @relation("InstructorWebinars")
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  plan                 String
  status               String    @default("ACTIVE")
  startDate            DateTime  @default(now())
  endDate              DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  user                 User      @relation(fields: [userId], references: [id])
}

model Curso {
  id            String         @id @default(cuid())
  title         String
  description   String
  image         String?
  introVideo    String?
  price         Float
  category      String         @default("General")
  totalHours    Int
  totalClasses  Int
  language      String         @default("Español")
  level         String
  content       String?
  isLive        Boolean        @default(false)
  liveUrl       String?
  instructorId  String
  createdAt     DateTime       @default(now())
  courseModules CourseModule[]   @relation("CursoToModules")
  instructor    User             @relation("MentorCursos", fields: [instructorId], references: [id])
  inscritos     Inscription[]
  purchases     CoursePurchase[]
}

model CourseModule {
  id        String   @id @default(cuid())
  title     String
  videoUrl  String?
  order     Int      @default(0)
  cursoId   String
  createdAt DateTime @default(now())
  curso     Curso    @relation("CursoToModules", fields: [cursoId], references: [id], onDelete: Cascade)
  lessons   Lesson[] @relation("ModuleToLessons")
}

model Lesson {
  id             String       @id @default(cuid())
  title          String
  summary        String?
  order          Int          @default(0)
  courseModuleId String
  createdAt      DateTime     @default(now())
  courseModule   CourseModule @relation("ModuleToLessons", fields: [courseModuleId], references: [id], onDelete: Cascade)
}

model Inscription {
  id           String   @id @default(cuid())
  status       String   @default("PENDING")
  method       String
  reference    String?
  phoneNumber  String?
  receiptImage String?
  amountPaid   Float
  userId       String
  cursoId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  curso        Curso?   @relation(fields: [cursoId], references: [id])
  user         User     @relation(fields: [userId], references: [id])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  details    String?
  userId     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model PlatformSection {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  roles     String[]
  createdAt DateTime @default(now())
}

model LiveStream {
  id            String    @id @default(cuid())
  title         String
  description   String?
  streamKey     String?
  rtmpsUrl      String?
  playbackId    String?
  status        String    @default("SCHEDULED")
  scheduledAt   DateTime?
  instructorId  String
  rtkMeetingId  String?
  createdAt     DateTime  @default(now())
  instructor    User      @relation("InstructorLives", fields: [instructorId], references: [id])
}

model PaymentGatewayConfig {
  id            String   @id @default(cuid())
  provider      String   @unique
  isEnabled     Boolean  @default(false)
  publicKey     String?
  secretKey     String?
  webhookSecret String?
  extraConfig   Json?
  updatedAt     DateTime @updatedAt
}

model SubscriptionPlan {
  id                String   @id @default(cuid())
  name              String   @unique
  slug              String   @unique
  price             Float
  description       String?
  hasLiveAccess     Boolean  @default(false)
  hasWebinarAccess  Boolean  @default(false)
  moduleIds         String[]
  paymentMethods    String[]
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Webinar {
  id              String           @id @default(cuid())
  title           String
  description     String?
  thumbnail       String?
  status          String           @default("SCHEDULED")
  scheduledAt     DateTime?
  instructorId    String
  rtkMeetingId    String?
  maxParticipants Int?
  createdAt       DateTime         @default(now())
  instructor      User             @relation("InstructorWebinars", fields: [instructorId], references: [id])
  sessions        WebinarSession[]
}

model WebinarSession {
  id        String   @id @default(cuid())
  webinarId String
  userId    String
  createdAt DateTime @default(now())
  webinar   Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@unique([webinarId, userId])
}

model PlatformApiConfig {
  id        String   @id @default(cuid())
  provider  String   @unique
  label     String
  config    Json
  updatedAt DateTime @updatedAt
}

model CoursePurchase {
  id                   String   @id @default(cuid())
  userId               String
  cursoId              String
  stripePaymentIntentId String?
  amount               Float
  status               String   @default("PENDING")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id])
  curso                Curso    @relation(fields: [cursoId], references: [id])

  @@unique([userId, cursoId])
}

model SiteConfig {
  id                String   @id @default(cuid())
  siteName          String   @default("Academia Credito USA")
  logoUrl           String?
  ctaText           String   @default("Quiero unirme ahora")
  ctaUrl            String   @default("/planes")
  instagramUrl      String?
  linkedinUrl       String?
  tiktokUrl         String?
  subscriptionPrice Float    @default(97)
  subscriptionPriceId String?
  navItems          Json     @default("[]")
  updatedAt         DateTime @updatedAt
}
